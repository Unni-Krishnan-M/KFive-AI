# Copy to .env and replace every required value. Use URL-safe database passwords.
KFIVE_MODE=local
AI_PROVIDER=ollama
AI_DEFAULT_MODEL=phi3
# Required only for Knowledge / RAG. Install this exact model on the configured
# provider first (for local Ollama, for example: ollama pull nomic-embed-text).
AI_EMBEDDING_MODEL=
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=30000
MONGO_ROOT_USERNAME=kfive
MONGO_ROOT_PASSWORD=replace-with-a-random-url-safe-password
MONGO_DATABASE=kfive_ai
REDIS_PASSWORD=replace-with-a-random-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
OLLAMA_BASE_URL=http://host.docker.internal:11434
FRONTEND_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
CODE_RUNNER_MODE=disabled

# Code Lab remains disabled unless started with ./scripts/kfive-up.sh --with-code-lab.
# Set the socket path and its numeric group ID for the trusted runner broker.
CODE_RUNNER_CONCURRENCY=2
CODE_RUNNER_DOCKER_SOCKET=/var/run/docker.sock
CODE_RUNNER_DOCKER_GID=replace-with-docker-socket-group-id

# Optional provider/runtime settings
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_SUPPORTS_EMBEDDINGS=false
OPENAI_COMPATIBLE_SUPPORTS_STRUCTURED_OUTPUT=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_SUPPORTS_EMBEDDINGS=false
CUSTOM_LLM_SUPPORTS_STRUCTURED_OUTPUT=false
DOCUMENT_PROCESSOR_URL=
OCR_SERVICE_URL=
