# Copy to a private mode-0600 .env.production file. Every digest and credential
# below is intentionally unusable and must be replaced before preflight passes.
KFIVE_PRODUCTION_PROJECT=kfive-production
KFIVE_VOLUME_PREFIX=kfive-production
KFIVE_EDGE_BIND_ADDRESS=127.0.0.1
KFIVE_EDGE_HTTP_PORT=8080

KFIVE_MODE=remote
PUBLIC_BASE_URL=https://kfive.example.com
CORS_ORIGIN=https://kfive.example.com
TRUST_PROXY_HOPS=2
AI_PROVIDER=openai-compatible
AI_DEFAULT_MODEL=replace-with-remote-model-id
AI_EMBEDDING_MODEL=
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=30000
OPENAI_BASE_URL=https://provider.example.com/v1
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_COMPATIBLE_SUPPORTS_EMBEDDINGS=false
OPENAI_COMPATIBLE_SUPPORTS_STRUCTURED_OUTPUT=false
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_SUPPORTS_EMBEDDINGS=false
CUSTOM_LLM_SUPPORTS_STRUCTURED_OUTPUT=false

MONGO_ROOT_USERNAME=kfive_root
MONGO_ROOT_PASSWORD=replace-with-url-safe-mongo-password
MONGO_DATABASE=kfive_ai
MONGO_APP_USERNAME=kfive
MONGO_APP_PASSWORD=replace-with-distinct-url-safe-app-password
REDIS_PASSWORD=replace-with-url-safe-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-value
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

KFIVE_BACKEND_IMAGE=registry.example.com/kfive/backend@sha256:1111111111111111111111111111111111111111111111111111111111111111
KFIVE_FRONTEND_IMAGE=registry.example.com/kfive/frontend@sha256:2222222222222222222222222222222222222222222222222222222222222222
KFIVE_MONGODB_IMAGE=mongo@sha256:3333333333333333333333333333333333333333333333333333333333333333
KFIVE_REDIS_IMAGE=redis@sha256:4444444444444444444444444444444444444444444444444444444444444444
KFIVE_CHROMADB_IMAGE=chromadb/chroma@sha256:5555555555555555555555555555555555555555555555555555555555555555
