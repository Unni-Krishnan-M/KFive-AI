# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1
KFIVE_MODE=local

# Database URLs
MONGODB_URL=mongodb://localhost:27017/kfive_ai
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000

# JWT Secrets (Change in production!)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Ollama Configuration
AI_PROVIDER=ollama
AI_DEFAULT_MODEL=phi3
# Required only for Knowledge / RAG; never defaults to the chat model.
AI_EMBEDDING_MODEL=
AI_MAX_OUTPUT_TOKENS=2048
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi3
OLLAMA_CODE_MODEL=deepseek-coder
OLLAMA_VISION_MODEL=llava
OLLAMA_SPEECH_MODEL=whisper

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=pdf,docx,pptx,txt,md,jpg,jpeg,png,gif

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# AI Configuration
MAX_CONTEXT_LENGTH=4096
AI_TIMEOUT_MS=30000
OPENAI_COMPATIBLE_SUPPORTS_EMBEDDINGS=false
OPENAI_COMPATIBLE_SUPPORTS_STRUCTURED_OUTPUT=false
CUSTOM_LLM_SUPPORTS_EMBEDDINGS=false
CUSTOM_LLM_SUPPORTS_STRUCTURED_OUTPUT=false

# Runtime services (leave empty when not configured)
PUBLIC_BASE_URL=http://localhost:3000
CODE_RUNNER_MODE=disabled
DOCUMENT_PROCESSOR_URL=
OCR_SERVICE_URL=

# Memory Configuration
MEMORY_RETENTION_DAYS=365
MAX_CONVERSATIONS_PER_USER=1000

# Queue Configuration
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5
