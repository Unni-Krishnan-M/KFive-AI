worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 256;
}

http {
  access_log off;
  server_tokens off;
  client_max_body_size 52m;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  server {
    listen __KFIVE_HTTP_LISTEN_PORT__ default_server;
    server_name _;
    return 421;
  }

  server {
    listen __KFIVE_HTTP_LISTEN_PORT__;
    server_name __KFIVE_DOMAIN__;
    return 308 __KFIVE_PUBLIC_ORIGIN__$request_uri;
  }

  server {
    listen __KFIVE_TLS_LISTEN_PORT__ ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 421;
  }

  server {
    listen __KFIVE_TLS_LISTEN_PORT__ ssl;
    server_name __KFIVE_DOMAIN__;

    ssl_certificate __KFIVE_CERTIFICATE_FILE__;
    ssl_certificate_key __KFIVE_PRIVATE_KEY_FILE__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
      proxy_pass http://__KFIVE_UPSTREAM__;
      proxy_http_version 1.1;
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_hide_header Strict-Transport-Security;
      proxy_hide_header X-Content-Type-Options;
      proxy_read_timeout 95s;
      proxy_send_timeout 95s;

      proxy_set_header Host __KFIVE_DOMAIN__;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Forwarded "";
      proxy_set_header X-Forwarded-Host "";
      proxy_set_header X-Forwarded-Port "";
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
  }
}
