{
  "name": "kfive-ai",
  "version": "1.0.0",
  "description": "Production-Level Offline Full Stack AI Assistant",
  "private": true,
  "overrides": {
    "refractor": {
      "prismjs": "1.30.0"
    }
  },
  "workspaces": [
    "frontend",
    "backend",
    "services/code-runner"
  ],
  "scripts": {
    "setup": "./setup.sh",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend && npm run build:code-runner",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:code-runner": "npm run build --workspace @kfive/code-runner",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "production:up": "./scripts/kfive-production-up.sh",
    "production:verify": "node scripts/verify-production-compose-live.cjs --allow-live-test",
    "production:verify:backup": "node scripts/verify-production-backup-live.cjs --allow-live-test",
    "production:verify:auth": "node scripts/verify-production-auth-live.cjs --allow-live-test",
    "production:verify:performance": "node scripts/verify-production-performance-live.cjs --allow-live-test",
    "production:verify:hybrid": "node scripts/verify-production-hybrid-live.cjs --allow-live-test",
    "production:tls:render": "node scripts/production-tls-config.cjs",
    "production:verify:tls": "node scripts/verify-production-tls-live.cjs --allow-live-test",
    "production:backup": "node scripts/production-backup.cjs",
    "production:restore": "node scripts/production-restore.cjs",
    "kind:up": "./scripts/kfive-kind-up.sh",
    "kind:up:observability": "./scripts/kfive-kind-up.sh --with-observability",
    "kind:up:datadog": "./scripts/kfive-kind-up.sh --with-datadog",
    "kind:up:gitops": "./scripts/kfive-kind-up.sh --with-gitops",
    "kind:down": "./scripts/kfive-kind-down.sh",
    "kind:verify": "node scripts/verify-kind-core-live.cjs --allow-live-test",
    "kind:verify:observability": "node scripts/verify-observability-live.cjs --allow-live-test",
    "kind:verify:logs": "node scripts/verify-loki-live.cjs --allow-live-test",
    "kind:verify:alerts": "node scripts/verify-alerting-live.cjs --allow-live-test",
    "kind:verify:probes": "node scripts/verify-subsystem-probes-live.cjs --allow-live-test",
    "kind:verify:network-policies": "node scripts/verify-network-policies-live.cjs --allow-live-test",
    "kind:verify:datadog": "node scripts/verify-datadog-live.cjs --allow-live-test",
    "kind:verify:gitops": "node scripts/verify-argocd-live.cjs --allow-live-test",
    "verify:repository-importer-process": "node scripts/verify-repository-importer-process-live.cjs",
    "verify:repository-importer-api": "node scripts/verify-repository-importer-api-live.cjs --allow-live-test",
    "verify:repository-importer-container": "node scripts/verify-repository-importer-container-live.cjs --allow-live-test",
    "kind:verify:repository-importer": "node scripts/verify-repository-importer-kubernetes-live.cjs --allow-live-test",
    "verify:repository-importer-resources": "node scripts/verify-repository-importer-resources-live.cjs --allow-live-test",
    "install:all": "npm install",
    "test": "npm run test:tooling-security && npm run test:frontend && npm run test:backend && npm run test:code-runner && npm run test:notebook-runtime && npm run test:notebook-lock && npm run test:ollama-bridge && npm run test:document-processor",
    "test:tooling-security": "node --test scripts/tooling-security.test.cjs",
    "test:ollama-bridge": "node --test services/ollama-bridge/server.test.cjs",
    "test:document-processor": "node --test services/document-processor/processor.test.cjs services/document-processor/server.test.cjs",
    "test:kubernetes": "node scripts/kind-ollama-socket.test.cjs && node scripts/kubernetes-manifests.test.cjs && node scripts/repository-importer-kubernetes.test.cjs && node --test services/subsystem-prober/server.test.cjs && node scripts/observability-manifests.test.cjs && node scripts/datadog-manifests.test.cjs",
    "test:observability": "node --test services/subsystem-prober/server.test.cjs && node scripts/observability-manifests.test.cjs && node scripts/datadog-manifests.test.cjs",
    "test:gitops": "node --test scripts/gitops-manifests.test.cjs",
    "test:repository-importer-container": "node --test scripts/repository-importer-compose.test.cjs",
    "test:repository-importer-kubernetes": "node scripts/repository-importer-kubernetes.test.cjs",
    "test:repository-importer-resources": "node --test scripts/repository-importer-resource.test.cjs",
    "test:production": "node --test scripts/production-compose.test.cjs scripts/production-backup.test.cjs scripts/production-auth.test.cjs scripts/production-performance.test.cjs scripts/production-hybrid.test.cjs scripts/production-tls.test.cjs",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "test:code-runner": "npm run test --workspace @kfive/code-runner",
    "test:notebook-runtime": "cd services/notebook-runtime && python3 -m unittest discover -s tests -v",
    "test:notebook-lock": "node scripts/notebook-runtime-lock.test.cjs",
    "verify:notebook-lock": "node scripts/verify-notebook-lock-live.cjs --allow-live-test",
    "verify:benchmark-host": "node scripts/verify-benchmark-host-live.cjs --allow-live-test",
    "verify:knowledge-pagination": "node scripts/verify-benchmark-host-live.cjs --allow-live-test --knowledge-pagination",
    "verify:benchmark-contract": "node scripts/verify-benchmark-host-live.cjs --allow-live-test --provider-contract",
    "lint": "npm run lint:frontend && npm run lint:backend && npm run lint:code-runner",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:code-runner": "npm run lint --workspace @kfive/code-runner",
    "ollama:setup": "./scripts/ollama-setup.sh",
    "dev:setup": "./scripts/dev-setup.sh",
    "clean": "rm -rf node_modules frontend/node_modules backend/node_modules frontend/dist backend/dist",
    "reset": "npm run clean && npm run install:all",
    "verify:rag-recovery": "node scripts/verify-rag-recovery-live.cjs --allow-live-test",
    "verify:rag-quota": "node scripts/verify-rag-quota-live.cjs --allow-live-test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
